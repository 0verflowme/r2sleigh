+/// Measurement only, behind `R2REWRITE_MEASURE`: canonicalise the function's
+/// machine projection and report, on stderr, what the rules would do to it
+/// and what that costs beside building the projection. Nothing of it reaches
+/// the rendering; the crate is not wired into the decompiler yet.
+fn measure_rewrite(trusted: &r2ssa::TrustedSsaArtifact) {
+    use std::time::Instant;
+    let artifact = trusted.artifact();
+    let name = source_function_name(trusted);
+    let started = Instant::now();
+    let projection = match r2ssa::MachineProjection::from_artifact(artifact) {
+        Ok(projection) => projection,
+        Err(error) => {
+            eprintln!("R2REWRITE_MEASURE fn={name} projection_error={error:?}");
+            return;
+        }
+    };
+    let projected = Instant::now();
+    let roots = match r2rewrite::canonicalize(artifact, &projection) {
+        Ok(roots) => roots,
+        Err(error) => {
+            eprintln!("R2REWRITE_MEASURE fn={name} canonicalize_error={error}");
+            return;
+        }
+    };
+    let canonicalised = Instant::now();
+    let base_casts = projection
+        .arena()
+        .iter()
+        .filter(|(_, expr)| matches!(expr.kind(), r2ssa::MachineExprKind::Cast { .. }))
+        .count();
+    let base_extracts = projection
+        .arena()
+        .iter()
+        .filter(|(_, expr)| matches!(expr.kind(), r2ssa::MachineExprKind::Extract { .. }))
+        .count();
+    let arena = roots.arena();
+    let count_kind = |root: r2rewrite::TermId, pick: fn(&r2rewrite::TermKind) -> bool| -> usize {
+        let mut seen = std::collections::HashSet::new();
+        let mut stack = vec![root];
+        let mut n = 0;
+        while let Some(id) = stack.pop() {
+            if !seen.insert(id) {
+                continue;
+            }
+            let term = arena.term(id);
+            if pick(&term.kind) {
+                n += 1;
+            }
+            stack.extend(term.kind.children());
+        }
+        n
+    };
+    let is_cast = |k: &r2rewrite::TermKind| {
+        matches!(
+            k,
+            r2rewrite::TermKind::Cast { .. } | r2rewrite::TermKind::Extract { .. }
+        )
+    };
+    let mut imported_casts = 0;
+    let mut canonical_casts = 0;
+    let mut rewritten = 0;
+    let mut literal_results = 0;
+    let mut opaque = 0;
+    let mut any = 0;
+    for value in roots.values() {
+        let imported = roots.import().value(value.value).map(|v| v.term);
+        if let Some(imported) = imported {
+            imported_casts += count_kind(imported, is_cast);
+        }
+        canonical_casts += count_kind(value.canonical, is_cast);
+        if value.trace.iter().any(|r| r.rule != r2rewrite::COPY_ELIDE) {
+            rewritten += 1;
+        }
+        match arena.term(value.canonical).kind {
+            r2rewrite::TermKind::Literal(_) => literal_results += 1,
+            r2rewrite::TermKind::Opaque(_) => opaque += 1,
+            _ => {}
+        }
+        if value.multiplicity == r2rewrite::Multiplicity::Any {
+            any += 1;
+        }
+    }
+    let counts: Vec<String> = roots
+        .rewrite_counts()
+        .iter()
+        .map(|(rule, n)| format!("{rule}={n}"))
+        .collect();
+    eprintln!(
+        "R2REWRITE_MEASURE fn={name} values={} entities={} projection_us={} canonicalize_us={} terms={} rewritten_values={rewritten} literal_results={literal_results} opaque={opaque} duplicable={any} base_cast_nodes={base_casts} base_extract_nodes={base_extracts} imported_cast_terms={imported_casts} canonical_cast_terms={canonical_casts} budget_failures={} rules[{}]",
+        artifact.graph().values.len(),
+        projection.entities().len(),
+        (projected - started).as_micros(),
+        (canonicalised - projected).as_micros(),
+        arena.len(),
+        roots.budget_failures().len(),
+        counts.join(",")
+    );
+}
