+/// How many bits of the returned value the function actually produced.
+///
+/// A function returning `uint32_t` on x86-64 leaves its result in `eax`, and
+/// the lift models that as a zero-extension into the 64-bit `rax` the ABI
+/// returns in. The carrier's width is therefore the register's, not the
+/// function's, and reading the declaration off it made every corpus function
+/// return `uint64_t` while forty-eight of the fifty-four return something
+/// narrower.
+///
+/// Following the definition through zero-extensions and whole-width copies
+/// finds the value the extension was applied to, which is the one the function
+/// computed. A sign extension is deliberately not followed: it says the value
+/// is signed, and its high bits are part of the value rather than padding.
+fn semantic_return_bits(source: &r2ssa::SsaArtifact, value: r2ssa::ValueId) -> u32 {
+    let graph = source.graph();
+    let mut value = value;
+    let mut bits = source.value_var(value).map_or(0, |var| var.size * 8);
+    // Bounded: each step moves to the operand of an extension or copy, and the
+    // graph is acyclic in that direction, but a bound keeps a malformed source
+    // from spinning.
+    for _ in 0..16 {
+        let Some(inst) = graph.def_inst(value).and_then(|inst| graph.inst(inst)) else {
+            return bits;
+        };
+        let r2ssa::InstPayload::Op(op) = &inst.payload else {
+            return bits;
+        };
+        let source_var = match op {
+            r2ssa::SSAOp::IntZExt { src, .. } => src,
+            r2ssa::SSAOp::Copy { dst, src } if dst.size == src.size => src,
+            _ => return bits,
+        };
+        let Some(next) = graph.value_id_for_var(source_var) else {
+            return bits;
+        };
+        bits = source_var.size * 8;
+        value = next;
+    }
+    bits
+}
+
+/// The widest return the function produces, across all of its returns.
+///
+/// Every `return` in one function shares one declared type, so the type has to
+/// hold the widest of them. A function with no certified return produces
+/// nothing to narrow and reports the full width.
+fn certified_return_bits(source: &r2ssa::SsaArtifact) -> u32 {
+    source
+        .certificates()
+        .returns
+        .iter()
+        .map(|certificate| semantic_return_bits(source, certificate.value))
+        .max()
+        .unwrap_or(u32::MAX)
+}
+
+/// The return type at the width the returned value actually occupies.
+///
+/// Only an unsigned integer is narrowed, and only downwards. A pointer, a
+/// float or a signed value is left alone: the width is how many bits the
+/// machine produced, which is a statement about occupancy rather than about
+/// what the bits mean, and narrowing anything whose meaning is not "an
+/// unsigned integer" would read more into it than it says.
+fn narrowed_return_type(ty: &r2types::CTypeLike, width_bits: u32) -> CType {
+    let r2types::CTypeLike::Int {
+        bits,
+        signedness: r2types::Signedness::Unsigned,
+    } = ty
+    else {
+        return ty.clone();
+    };
+    if width_bits >= *bits || !matches!(width_bits, 8 | 16 | 32 | 64) {
+        return ty.clone();
+    }
+    CType::uint(width_bits)
+}
