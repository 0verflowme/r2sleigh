NAME=sla_lift_store_tracks_stack_write
FILE=bins/vuln_test_x86
ARGS=-e scr.color=false -e bin.relocs.apply=true
EXPECT=<<EOF_EXPECT
true
EOF_EXPECT
CMDS=<<EOF_CMDS
s `is~check_secret[2]`+0x4 >/dev/null
a:sla.debug.mem | jq -c 'length == 1 and .[0].write == true and .[0].stack == true and .[0].stack_base == "RBP" and .[0].stack_offset == -8'
EOF_CMDS
RUN

NAME=sla_lift_cmp_writes_flags_and_reads_stack
FILE=bins/vuln_test_x86
ARGS=-e scr.color=false -e bin.relocs.apply=true
EXPECT=<<EOF_EXPECT
true
EOF_EXPECT
CMDS=<<EOF_CMDS
s `is~check_secret[2]`+0x7 >/dev/null
a:sla.debug.regs > /tmp/r2sleigh_core_regs.json
a:sla.debug.mem > /tmp/r2sleigh_core_mem.json
jq -n -c --slurpfile regs /tmp/r2sleigh_core_regs.json --slurpfile mem /tmp/r2sleigh_core_mem.json '($regs[0].write | index("ZF") != null) and ($regs[0].write | index("CF") != null) and (($mem[0] | map(select(.write == false and .stack == true and .stack_offset == -8)) | length) == 1)'
EOF_CMDS
RUN

