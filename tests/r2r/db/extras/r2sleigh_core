NAME=sla_lift_store_tracks_stack_write
FILE=malloc://64
ARGS=-a x86 -b 64 -e scr.color=false -e log.level=0
EXPECT=<<EOF_EXPECT
true
EOF_EXPECT
CMDS=<<EOF_CMDS
wx 488945f8000000000000000000000000
s 0 >/dev/null
a:sla.debug.mem | jq -c 'length == 1 and .[0].schema_version == 1 and .[0].type == "store" and .[0].stack_address.base == "RBP" and .[0].stack_address.offset == -8'
EOF_CMDS
RUN

NAME=sla_lift_cmp_writes_flags_and_reads_stack
FILE=malloc://64
ARGS=-a x86 -b 64 -e scr.color=false -e log.level=0
EXPECT=<<EOF_EXPECT
true
EOF_EXPECT
CMDS=<<EOF_CMDS
wx 48837df8000000000000000000000000
s 0 >/dev/null
a:sla.debug.regs > /tmp/r2sleigh_core_regs.json
a:sla.debug.mem > /tmp/r2sleigh_core_mem.json
jq -n -c --slurpfile regs /tmp/r2sleigh_core_regs.json --slurpfile mem /tmp/r2sleigh_core_mem.json '($regs[0].write | index("ZF") != null) and ($regs[0].write | index("CF") != null) and (($mem[0] | map(select(.type == "load" and .stack_address.offset == -8)) | length) == 1)'
EOF_CMDS
RUN

